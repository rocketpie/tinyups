# run opencode directly on the wsl host
curl -fsSL https://opencode.ai/v2/install | bash
opencode service set hostname 0.0.0.0
opencode pair


# devcontainer 
## install / update / uninstall 
    curl -fsSL https://raw.githubusercontent.com/devcontainers/cli/main/scripts/install.sh | sh
    curl -fsSL https://raw.githubusercontent.com/devcontainers/cli/main/scripts/install.sh | sh -s -- --update
    curl -fsSL https://raw.githubusercontent.com/devcontainers/cli/main/scripts/install.sh | sh -s -- --uninstall

# run opencode in the dev container
cd ~/workspaces/tinyups
devcontainer up --remove-existing-container
devcontainer exec opencode pair


make test    # muss 6/6 grün sein
make help    # listet alle Ziele