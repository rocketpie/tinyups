(version 1)

# TinyUPS custom design rules — JLCPCB standard capabilities (5 mil).
# These are minimums; the board's own settings are equal or stricter, so
# adding this file does not create violations.

(rule "JLCPCB min track width" (constraint track_width (min 0.127mm)))
(rule "JLCPCB min clearance" (constraint clearance (min 0.127mm)))
(rule "JLCPCB min via diameter" (constraint via_diameter (min 0.45mm)))
(rule "JLCPCB min via hole" (constraint hole_size (min 0.3mm)))
(rule "JLCPCB min annular ring" (constraint annular_width (min 0.13mm)))
