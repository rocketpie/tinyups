{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": ["-p", "4096:4096"],
    "mounts": [
        {
            "source": "${localWorkspaceFolder}",
            "target": "/tinyups",
            "type": "bind"
        }
    ],
    "forwardPorts": [4096],
    "postStartCommand": "opencode service set hostname 0.0.0.0 && opencode service set port 4096 && opencode service start"
}
